/*

 * NEW ATTENDANCE PAGE

 * - Uses the same database as DASH.php

 * - Gets the browser/device's realtime GPS location

 * - Reverse-geocodes GPS to Barangay + Street

 * - NO GPS ACCURACY CHECK

 * - NO DISTRICT SELECTION ON THE ATTENDANCE FORM

 * - Attendance can still be submitted even if location is unavailable

 */



$host     = "sql204.infinityfree.com";

$dbname   = "if0_42565018_test";

$username = "if0_42565018";

$password = "PeoIsabela123";

try {

    $pdo = new PDO(

        "mysql:host=$host;dbname=$dbname;charset=utf8mb4",

        $username,

        $password,

        [

            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,

            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC

        ]

    );

} catch (PDOException $e) {

    die("Database connection failed: " . htmlspecialchars($e->getMessage()));

}



/* Make sure the attendance table exists. */

$pdo->exec("

    CREATE TABLE IF NOT EXISTS PeoAttendance_clockin (

        id INT AUTO_INCREMENT PRIMARY KEY,

        worker_name VARCHAR(255) NOT NULL,

        role VARCHAR(100) DEFAULT '',

        address VARCHAR(500) DEFAULT NULL,

        district VARCHAR(50) DEFAULT 'District I',

        clock_in_time DATETIME DEFAULT CURRENT_TIMESTAMP,

        status VARCHAR(50) DEFAULT 'Pending'

    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

");



/* Add the new location fields if the existing table does not have them. */

$columns = [

    'latitude'  => "DECIMAL(10,8) DEFAULT NULL",

    'longitude' => "DECIMAL(11,8) DEFAULT NULL",

    'barangay'  => "VARCHAR(255) DEFAULT NULL",

    'street'    => "VARCHAR(255) DEFAULT NULL",

    'location_address' => "VARCHAR(1000) DEFAULT NULL"

];



foreach ($columns as $column => $definition) {

    $check = $pdo->query("SHOW COLUMNS FROM PeoAttendance_clockin LIKE " . $pdo->quote($column));

    if (!$check || $check->rowCount() === 0) {

        $pdo->exec("ALTER TABLE PeoAttendance_clockin ADD COLUMN `$column` $definition");

    }

}



/* Current logged-in user, if available. */

$user = null;

if (isset($_SESSION['user_id'])) {

    $stmt = $pdo->prepare("SELECT * FROM peosign WHERE id = ?");

    $stmt->execute([$_SESSION['user_id']]);

    $user = $stmt->fetch();

}



$defaultName = $user['fullname'] ?? $user['full_name'] ?? $user['name'] ?? $user['username'] ?? '';

$defaultRole = $user['role'] ?? '';



$message = '';

$messageType = 'success';



if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['submit_attendance'])) {



    $workerName = trim($_POST['worker_name'] ?? '');

    $role = trim($_POST['role'] ?? '');

    // District is intentionally not collected from the attendance form.

    $district = '';



    $latitude = isset($_POST['latitude']) && $_POST['latitude'] !== ''

        ? (float)$_POST['latitude']

        : null;



    $longitude = isset($_POST['longitude']) && $_POST['longitude'] !== ''

        ? (float)$_POST['longitude']

        : null;



    $barangay = trim($_POST['barangay'] ?? '');

    $street = trim($_POST['street'] ?? '');

    $locationAddress = trim($_POST['location_address'] ?? '');



    /*

     * Address is kept populated for compatibility with the existing

     * DASH.php attendance table, while the new fields keep Barangay/Street

     * separately.

     */

    $addressParts = [];

    if ($street !== '') $addressParts[] = $street;

    if ($barangay !== '') $addressParts[] = 'Barangay ' . $barangay;

    if ($locationAddress !== '' && empty($addressParts)) $addressParts[] = $locationAddress;

    $address = implode(', ', $addressParts);



    if ($workerName === '') {

        $message = 'Please enter the worker name.';

        $messageType = 'error';

    } else {

        $stmt = $pdo->prepare("

            INSERT INTO PeoAttendance_clockin

            (worker_name, role, address, district, clock_in_time, status,

             latitude, longitude, barangay, street, location_address)

            VALUES (?, ?, ?, ?, NOW(), 'Pending', ?, ?, ?, ?, ?)

        ");



        $stmt->execute([

            $workerName,

            $role,

            $address,

            $district,

            $latitude,

            $longitude,

            $barangay,

            $street,

            $locationAddress

        ]);



        $message = 'Attendance submitted successfully!';

        $messageType = 'success';



        // Clear only location values after a successful submission.

        $_POST['latitude'] = '';

        $_POST['longitude'] = '';

        $_POST['barangay'] = '';

        $_POST['street'] = '';

        $_POST['location_address'] = '';

    }

}

