$popup_type = "";
$popup_title = "";
$popup_message = "";
$redirect_now = false;
$show_reset_form = false;
$reset_mobile = "";

/* MYSQLI DATABASE CONNECTION CONFIG (XAMPP DEFAULT) */
$host     = "sql204.infinityfree.com";
$username = "if0_42565018";
$password = "PeoIsabela123";
$dbname   = "if0_42565018_test"; // Siguraduhing na-create ang database na ito sa phpMyAdmin

$conn = new mysqli($host, $username, $password, $dbname);

// Check Connection
if ($conn->connect_error) {
    $conn = null;
} else {
    $conn->set_charset("utf8");
}

/* PROCESS FORMS (LOGIN, SIGNUP, FORGOT PASSWORD, RESET PASSWORD) */
if ($_SERVER["REQUEST_METHOD"] == "POST" && $conn) {

    // 1. SIGN UP ACTION
    if (isset($_POST['action']) && $_POST['action'] == 'signup') {
        $id_num       = trim($_POST['signup_id'] ?? '');
        $email        = strtolower(trim($_POST['signup_email'] ?? ''));
        $mobile       = trim($_POST['signup_mobile'] ?? ''); 
        $username_reg = trim($_POST['signup_username'] ?? '');
        $position     = trim($_POST['signup_position'] ?? '');
        $district     = trim($_POST['signup_district'] ?? '');
        $pass_input   = trim($_POST['signup_password'] ?? '');
        $pass_confirm = trim($_POST['signup_confirm_password'] ?? '');

        if (!empty($id_num) && !empty($email) && !empty($mobile) && !empty($username_reg) && !empty($position) && !empty($district) && !empty($pass_input) && !empty($pass_confirm)) {
            
            if ($pass_input !== $pass_confirm) {
                $popup_type = "error";
                $popup_title = "Password Mismatch";
                $popup_message = "The create password and confirm password fields do not match.";
            } else {
                // Check kung may umiiral nang email, ID number, o mobile number
                $stmt = $conn->prepare("SELECT id FROM peosign WHERE LOWER(email) = ? OR id = ? OR mobile_number = ?");
                $stmt->bind_param("sss", $email, $id_num, $mobile);
                $stmt->execute();
                $result = $stmt->get_result();

                if ($result->num_rows > 0) {
                    $popup_type = "error";
                    $popup_title = "Account Exists";
                    $popup_message = "This Email Address, ID Number, or Mobile Number is already registered.";
                } else {
                    $hashed_password = password_hash($pass_input, PASSWORD_DEFAULT);
                    
                    // Insert bagong user sa peosign table
                    $insert_stmt = $conn->prepare("INSERT INTO peosign (id, email, mobile_number, username, position, district, password, status) VALUES (?, ?, ?, ?, ?, ?, ?, 'pending')");
                    $insert_stmt->bind_param("sssssss", $id_num, $email, $mobile, $username_reg, $position, $district, $hashed_password);

                    if ($insert_stmt->execute()) {
                        $popup_type = "success";
                        $popup_title = "Registration Successful";
                        $popup_message = "Your account has been created, but it requires Admin approval before you can log in.";
                    } else {
                        $popup_type = "error";
                        $popup_title = "Database Error";
                        $popup_message = "Failed to register. Please ensure your peosign table has all required columns.";
                    }
                    $insert_stmt->close();
                }
                $stmt->close();
            }
        } else {
            $popup_type = "warning";
            $popup_title = "Incomplete Fields";
            $popup_message = "Please fill in all registration fields.";
        }
    } 
    
    // 2. LOGIN ACTION
    elseif (isset($_POST['action']) && $_POST['action'] == 'login') {
        $email      = strtolower(trim($_POST['email'] ?? ''));
        $pass_input = trim($_POST['password'] ?? '');

        if (!empty($email) && !empty($pass_input)) {
            $stmt = $conn->prepare("SELECT * FROM peosign WHERE LOWER(email) = ?");
            $stmt->bind_param("s", $email);
            $stmt->execute();
            $result = $stmt->get_result();
            $account = $result->fetch_assoc();

            if ($account) {
                $is_valid = password_verify($pass_input, $account['password']) || ($pass_input === $account['password']);

                if ($is_valid) {
                    $status = $account['status'] ?? 'approved'; 
                    
                    if ($status === 'pending' || $status === 'inactive') {
                        $popup_type = "error";
                        $popup_title = "Access Denied";
                        $popup_message = "Your account is pending approval by the Provincial Engineering Office administrator.";
                    } else {
                        $_SESSION['user_id'] = $account['id'];
                        $popup_type = "success";
                        $popup_title = "Welcome!";
                        $popup_message = "Login successful. Redirecting to dashboard...";
                        $redirect_now = true;
                    }
                } else {
                    $popup_type = "error";
                    $popup_title = "Login Failed";
                    $popup_message = "Wrong password. Please try again.";
                }
            } else {
                $popup_type = "error";
                $popup_title = "Account Not Found";
                $popup_message = "Email not found. Please check your email address.";
            }
            $stmt->close();
        } else {
            $popup_type = "warning";
            $popup_title = "Incomplete Fields";
            $popup_message = "Please fill in both Email and Password fields.";
        }
    }

    // 3. FORGOT PASSWORD REQUEST
    elseif (isset($_POST['action']) && $_POST['action'] == 'forgot_password') {
        $mobile = trim($_POST['forgot_mobile'] ?? '');

        if (!empty($mobile)) {
            $stmt = $conn->prepare("SELECT id FROM peosign WHERE mobile_number = ?");
            $stmt->bind_param("s", $mobile);
            $stmt->execute();
            $result = $stmt->get_result();

            if ($result->num_rows > 0) {
                $otp = rand(100000, 999999);
                
                $update = $conn->prepare("UPDATE peosign SET otp_code = ?, forgot_pass_notif = 1 WHERE mobile_number = ?");
                $update->bind_param("is", $otp, $mobile);
                $update->execute();
                $update->close();

                $popup_type = "success";
                $popup_title = "OTP Sent!";
                $popup_message = "An OTP has been sent. The Admin has also been notified. (SIMULATED OTP: $otp)";
                
                $show_reset_form = true;
                $reset_mobile = $mobile;
            } else {
                $popup_type = "error";
                $popup_title = "Number Not Found";
                $popup_message = "This mobile number is not registered in our system.";
            }
            $stmt->close();
        }
    }

    // 4. RESET PASSWORD VERIFICATION
    elseif (isset($_POST['action']) && $_POST['action'] == 'reset_password') {
        $mobile    = trim($_POST['reset_mobile'] ?? '');
        $otp_input = trim($_POST['reset_otp'] ?? '');
        $new_pass  = trim($_POST['new_password'] ?? '');

        if (!empty($mobile) && !empty($otp_input) && !empty($new_pass)) {
            $stmt = $conn->prepare("SELECT id FROM peosign WHERE mobile_number = ? AND otp_code = ?");
            $stmt->bind_param("ss", $mobile, $otp_input);
            $stmt->execute();
            $result = $stmt->get_result();
            
            if ($result->num_rows > 0) {
                $hashed_password = password_hash($new_pass, PASSWORD_DEFAULT);
                
                $update = $conn->prepare("UPDATE peosign SET password = ?, otp_code = NULL, forgot_pass_notif = 0 WHERE mobile_number = ?");
                $update->bind_param("ss", $hashed_password, $mobile);
                $update->execute();
                $update->close();

                $popup_type = "success";
                $popup_title = "Success";
                $popup_message = "Your password has been reset successfully. You can now login.";
            } else {
                $popup_type = "error";
                $popup_title = "Invalid OTP";
                $popup_message = "The OTP you entered is incorrect.";
                $show_reset_form = true;
                $reset_mobile = $mobile;
            }
            $stmt->close();
        }
    }
}
