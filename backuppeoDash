function getStatusBadgeClass($status) {
    switch (strtolower(trim($status))) {
        case 'pending':
            return 'badge-pending';
        case 'ongoing':
            return 'badge-ongoing';
        case 'completed':
            return 'badge-completed';
        default:
            return 'status-default'; // Fallback badge class
    }
}

/* Kinukuha ang Completion % base sa kasalukuyang Status ng project,
   sa halip na manual/nakatagong input na madalas na-o-overwrite ng 0. */
function getCompletionPercentByStatus($status) {
    switch (strtolower(trim($status))) {
        case 'completed':
            return 100;
        case 'ongoing':
            return 50;
        case 'on hold':
        case 'not complete':
            return 25;
        case 'approved':
            return 0;
        case 'pending':
        case 'pending approval':
        case 'disapproved':
        case 'rejected':
        default:
            return 0;
    }
}

