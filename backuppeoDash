function updateLocationDropdown(districtId, locationId) {
    const distSelect = document.getElementById(districtId);
    const locSelect = document.getElementById(locationId);
    
    if (!distSelect || !locSelect) return;
    
    const selectedDist = distSelect.value;
    // If no district is selected, load all municipalities as fallback
    const normalized = selectedDist ? normalizeDistrictName(selectedDist) : '';
    const options = getMunicipalityOptions(normalized);
    
    locSelect.innerHTML = '<option value="">-- Select Municipality / City --</option>';
    
    if (!selectedDist || !districtMunicipalities[normalized]) {
        // Group them if "All" or empty is selected
        let groupEl = null;
        let lastGroup = null;
        options.forEach(({ muni, group }) => {
            if (group !== lastGroup) {
                groupEl = document.createElement('optgroup');
                groupEl.label = group;
                locSelect.appendChild(groupEl);
                lastGroup = group;
