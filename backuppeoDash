$backupDir = 'uploads/backups/';
if (!file_exists($backupDir)) {
    @mkdir($backupDir, 0777, true);
}
$backupTables = ['peoproject_approval', 'peoproject', 'peo_workforce', 'peo_notifications', 'peo_attendance', 'peosign'];

if (isset($_GET['create_backup'])) {
    if (!$canUseRestoreBackup) {
        $msg = "You do not have permission to create a backup.";
        $msgType = "error";
    } else {
        try {
            $backupFileName = 'backup_' . date('Y-m-d_His') . '.sql';
            $sqlContent = "-- Provincial Engineering Office Database Backup\n-- Generated: " . date('Y-m-d H:i:s') . "\n\n";
            $sqlContent .= "SET FOREIGN_KEY_CHECKS=0;\n\n";

            foreach ($backupTables as $tbl) {
                try {
                    $checkStmt = $pdo->query("SHOW TABLES LIKE '" . $tbl . "'");
                    if ($checkStmt->rowCount() === 0) continue;

                    $createStmt = $pdo->query("SHOW CREATE TABLE `$tbl`");
                    $createRow = $createStmt->fetch(PDO::FETCH_ASSOC);
                    $sqlContent .= "DROP TABLE IF EXISTS `$tbl`;\n";
                    $sqlContent .= $createRow['Create Table'] . ";\n\n";

                    $rowsStmt = $pdo->query("SELECT * FROM `$tbl`");
                    $rows = $rowsStmt->fetchAll(PDO::FETCH_ASSOC);
                    foreach ($rows as $row) {
                        $cols = array_map(fn($c) => "`$c`", array_keys($row));
                        $vals = array_map(function($v) use ($pdo) {
                            return $v === null ? 'NULL' : $pdo->quote($v);
                        }, array_values($row));
                        $sqlContent .= "INSERT INTO `$tbl` (" . implode(', ', $cols) . ") VALUES (" . implode(', ', $vals) . ");\n";
                    }
                    $sqlContent .= "\n";
                } catch (PDOException $e) {
                    $sqlContent .= "-- Skipped table $tbl: " . $e->getMessage() . "\n\n";
                }
            }
            $sqlContent .= "SET FOREIGN_KEY_CHECKS=1;\n";

            file_put_contents($backupDir . $backupFileName, $sqlContent);

            $actorName = $user['fullname'] ?? $user['username'] ?? 'Isang user';
            notifyAdmins($pdo, $user['id'], $actorName, "$actorName created a new database backup (\"$backupFileName\") on the Restore Backup page.");

            header("Location: DASH.php?page=restore_backup&district=" . urlencode($district) . "&msg=backup_created");
            exit();
        } catch (Exception $e) {
            $msg = "Backup failed: " . $e->getMessage();
            $msgType = "error";
        }
    }
}

