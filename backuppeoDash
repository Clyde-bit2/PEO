if (isset($_GET['restore_trash_id'])) {
    if (!($isSuperAdmin || $isAdmin || $canUseRestoreBackup || $canEditProjectMonitoring || $canEditWorkforce)) {
        $msg = "You do not have permission to restore this record.";
        $msgType = "error";
    } else {
        $trashId = intval($_GET['restore_trash_id']);
        $tStmt = $pdo->prepare("SELECT * FROM peo_trash WHERE id = ?");
        $tStmt->execute([$trashId]);
        $trashRow = $tStmt->fetch(PDO::FETCH_ASSOC);

        if (!$trashRow) {
            $msg = "Trash record not found.";
            $msgType = "error";
        } else {
            try {
                $recordData = json_decode($trashRow['record_data'], true);
                $origTable = $trashRow['original_table'];

                if (is_array($recordData)) {
                    // Alisin muna ang 'id' key para hindi mag-conflict sa auto-increment,
                    // pero subukan munang panatilihin ang orihinal na id kung available pa.
                    $cols = array_keys($recordData);
                    $placeholders = implode(', ', array_fill(0, count($cols), '?'));
                    $colList = implode(', ', array_map(fn($c) => "`$c`", $cols));

                    try {
                        $insertBack = $pdo->prepare("INSERT INTO `$origTable` ($colList) VALUES ($placeholders)");
                        $insertBack->execute(array_values($recordData));
                    } catch (PDOException $e) {
                        // Baka existing na ang orihinal na id - i-insert na lang ulit na walang id (bagong id na lang)
                        unset($recordData['id']);
                        $cols = array_keys($recordData);
                        $placeholders = implode(', ', array_fill(0, count($cols), '?'));
                        $colList = implode(', ', array_map(fn($c) => "`$c`", $cols));
                        $insertBack = $pdo->prepare("INSERT INTO `$origTable` ($colList) VALUES ($placeholders)");
                        $insertBack->execute(array_values($recordData));
                    }

                    $delTrash = $pdo->prepare("DELETE FROM peo_trash WHERE id = ?");
                    $delTrash->execute([$trashId]);

                    $actorName = $user['fullname'] ?? $user['username'] ?? 'Isang user';
                    $trashLabel = $trashRow['record_label'] ?? ('Record #' . $trashId);
                    notifyAdmins($pdo, $user['id'], $actorName, "$actorName restored \"$trashLabel\" from the Restore Backup page.");

                    header("Location: DASH.php?page=restore_backup&district=" . urlencode($district) . "&msg=record_restored");
                    exit();
                } else {
                    $msg = "Corrupted trash record data.";
                    $msgType = "error";
                }
            } catch (PDOException $e) {
                $msg = "Restore failed: " . $e->getMessage();
                $msgType = "error";
            }
        }
    }
}

