if (isset($_GET['approve_proj_id'])) {
    if (!$canEditProjectMonitoring) {
        $msg = "You do not have permission to approve projects.";
        $msgType = "error";
    } else {
        $pId = intval($_GET['approve_proj_id']);
        
        // 1. Kukunin ang record mula sa approval queue table (peoproject_approval)
        $stmtGet = $pdo->prepare("SELECT * FROM peoproject_approval WHERE id = ?");
        $stmtGet->execute([$pId]);
        $projToApprove = $stmtGet->fetch(PDO::FETCH_ASSOC);

        if ($projToApprove) {
            try {
                // Gagamit ng Database Transaction para ligtas ang insert at delete operations
                $pdo->beginTransaction();

                // 2. I-insert ang data papunta sa main monitoring table (22 columns, 22 parameters)
                $sqlInsert = "INSERT INTO peoproject (
                    project_name, original_project_name, project_number, location, district, 
                    start_date, date_approved, target_completion, status, engineers_assigned, 
                    architecture_image, budget, bidding_status, approved_budget_for_contract, 
                    remark, source_of_fund, duration, pre_bid_date, bidding_date, 
                    noa_date, contract_amount, ntp_date
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

                $stmtInsert = $pdo->prepare($sqlInsert);
                $stmtInsert->execute([
                    $projToApprove['project_name'],
                    $projToApprove['original_project_name'],
                    $projToApprove['project_number'],
                    $projToApprove['location'],
                    $projToApprove['district'],
                    $projToApprove['start_date'],
                    date('Y-m-d'),
                    $projToApprove['target_completion'],
                    'Approved', // Dynamic value para sa status column
                    $projToApprove['engineers_assigned'],
                    $projToApprove['architecture_image'],
                    $projToApprove['budget'],
                    $projToApprove['bidding_status'],
                    $projToApprove['approved_budget_for_contract'],
                    $projToApprove['remark'],
                    $projToApprove['source_of_fund'],
                    $projToApprove['duration'],
                    $projToApprove['pre_bid_date'],
                    $projToApprove['bidding_date'],
                    $projToApprove['noa_date'],
                    $projToApprove['contract_amount'],
                    $projToApprove['ntp_date']
                ]);

                // 3. Buburahin ang proposal sa queue pagkatapos ma-insert
                $stmtDel = $pdo->prepare("DELETE FROM peoproject_approval WHERE id = ?");
                $stmtDel->execute([$pId]);

                // I-commit ang mga pagbabago
                $pdo->commit();

                $actorName = $user['fullname'] ?? $user['username'] ?? 'Isang user';
                notifyAdmins($pdo, $user['id'], $actorName, "$actorName approved the project proposal \"" . $projToApprove['project_name'] . "\" in the Project Approval Queue. Na-move na ito sa Project Monitoring.");

