};

// HELPER: Ginagawang Roman Numeral (District I, District II...) kahit "District 1" o "1" lang ang galing sa PHP
function normalizeDistrictName(rawDistrict) {
    if (!rawDistrict) return '';
    let str = rawDistrict.trim();
    
    // Kung number lang pumasok (e.g. "1" -> "District I")
    const romanMap = { '1': 'I', '2': 'II', '3': 'III', '4': 'IV', '5': 'V', '6': 'VI' };
    
    if (romanMap[str]) {
        return 'District ' + romanMap[str];
    }
    
    // Kung "District 1" pumasok -> gagawing "District I"
    return str.replace(/District\s*([1-6])/i, function(match, num) {
        return 'District ' + romanMap[num];
    });
}

// Kunin ang active district mula sa PHP at i-normalize
const rawDistrictPHP = '<?php echo isset($district) ? addslashes($district) : ""; ?>';
const currentDistrict = normalizeDistrictName(rawDistrictPHP);

// HELPER: Kunin ang listahan ng municipalities. Kung tiyak na district
// (District I - VI), ibalik lang ang munisipyo niyan. Kung "All Districts"
// o hindi kilalang value, i-combine LAHAT ng municipalities mula sa anim
// na district (dating nagiging EMPTY/walang laman ito dati kaya hindi
// mapipili ang "Assigned Location" at hindi natutuloy ang pag-add ng
// Workforce/Project kapag "All Districts" ang kasalukuyang view).
function getMunicipalityOptions(normalizedDistrict) {
    if (districtMunicipalities[normalizedDistrict]) {
        return districtMunicipalities[normalizedDistrict].map(m => ({ muni: m, group: normalizedDistrict }));
    }
    let combined = [];
    Object.keys(districtMunicipalities).forEach(dist => {
        districtMunicipalities[dist].forEach(m => combined.push({ muni: m, group: dist }));
    });
    return combined;
}

// 2. MAIN FUNCTION: POPULATE ALL LOCATION DROPDOWNS ON INITIAL PAGE LOAD
function populateMunicipalitySelects() {
    const options = getMunicipalityOptions(currentDistrict);
    const isCombined = !districtMunicipalities[currentDistrict];

    // KINOMBINASYON LAHAT NG DROPDOWN IDs (PROJECT AT WORKFORCE)
    const targetIDs = [
        'add_proj_location', 
        'edit_proj_location', 
        'queue_edit_location', 
        'projLocationSelect',  // Filter sa Project Monitoring
        'wfLocationSelect'     // Filter sa Workforce Management
    ];

    targetIDs.forEach(id => {
        const sel = document.getElementById(id);
        if (sel) {
            // Panatilihin ang dating napiling value kung mayroon na
            const currentValue = sel.value;

            sel.innerHTML = '<option value="">-- Select Municipality / City --</option>';

            if (isCombined) {
                // Grupuhin per district gamit ang <optgroup> para malinaw sa user
                let groupEl = null;
                let lastGroup = null;
                options.forEach(({ muni, group }) => {
                    if (group !== lastGroup) {
                        groupEl = document.createElement('optgroup');
                        groupEl.label = group;
                        sel.appendChild(groupEl);
                        lastGroup = group;
                    }
                    const opt = document.createElement('option');
                    opt.value = muni.trim();
                    opt.textContent = muni.trim();
                    groupEl.appendChild(opt);
                });
            } else {
                options.forEach(({ muni }) => {
                    const opt = document.createElement('option');
                    opt.value = muni.trim();
                    opt.textContent = muni.trim();
                    sel.appendChild(opt);
                });
            }

            if (currentValue) {
                sel.value = currentValue;
            }
        }
    });
}

