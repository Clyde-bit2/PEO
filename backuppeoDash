/* HELPER FUNCTION FOR SANITIZING DECIMAL/CURRENCY INPUTS */
function cleanNumberInput($val) {
    if (is_numeric($val)) {
        return floatval($val);
    }
    // Tinatanggal ang koma (,) at iba pang hindi numerikong karakter maliban sa tuldok (.)
    $cleaned = preg_replace('/[^\d.]/', '', str_replace(',', '', (string)$val));
    return is_numeric($cleaned) ? floatval($cleaned) : 0.00;
}

/* HELPER FUNCTION: Ilagay ang buong record sa peo_trash bago ito burahin,
   para ma-restore pa ito kahit individual record lang ang na-delete. */
function moveRecordToTrash($pdo, $table, $id) {
    try {
        $stmt = $pdo->prepare("SELECT * FROM `$table` WHERE id = ?");
        $stmt->execute([$id]);
        $row = $stmt->fetch(PDO::FETCH_ASSOC);
        if (!$row) return false;

        $label = $row['project_name'] ?? $row['worker_name'] ?? $row['Employee_name'] ?? ('Record #' . $id);

        $insert = $pdo->prepare("INSERT INTO peo_trash (original_table, original_id, record_label, record_data) VALUES (?, ?, ?, ?)");
        $insert->execute([$table, $id, $label, json_encode($row)]);
        return true;
    } catch (PDOException $e) {
        return false;
    }
}

/* HELPER FUNCTION: Magpadala ng notification sa Admin at Head Admin (Super Admin).
   Isang beses lang itong ilalagay sa peo_notifications table, at makikita ito
   ng kahit sino sa Admin/Head Admin dahil sila ang tinitingnan ng notification bell. */
function notifyAdmins($pdo, $senderId, $senderName, $message) {
    try {
        $stmt = $pdo->prepare("INSERT INTO peo_notifications (sender_id, sender_name, message) VALUES (?, ?, ?)");
        $stmt->execute([$senderId ?: 0, $senderName ?: 'System', $message]);
        return true;
    } catch (PDOException $e) {
        return false;
    }
}

