<script>

const statusEl = document.getElementById('locationStatus');

const barangayDisplay = document.getElementById('barangayDisplay');

const streetDisplay = document.getElementById('streetDisplay');

const addressDisplay = document.getElementById('addressDisplay');

const coordinatesDisplay = document.getElementById('coordinatesDisplay');



const latitudeInput = document.getElementById('latitude');

const longitudeInput = document.getElementById('longitude');

const barangayInput = document.getElementById('barangay');

const streetInput = document.getElementById('street');

const locationAddressInput = document.getElementById('location_address');



function setStatus(text) {

    statusEl.textContent = text;

}



function clearLocationDisplay() {

    barangayDisplay.textContent = 'Not detected';

    streetDisplay.textContent = 'Not detected';

    addressDisplay.textContent = 'Not detected';

    coordinatesDisplay.textContent = 'Not detected';



    latitudeInput.value = '';

    longitudeInput.value = '';

    barangayInput.value = '';

    streetInput.value = '';

    locationAddressInput.value = '';

}



function getCurrentLocation() {

    if (!navigator.geolocation) {

        setStatus('GPS is not supported by this browser.');

        return;

    }



    setStatus('Getting current location...');



    /*

     * No enableHighAccuracy requirement is used as a validation rule.

     * The browser is simply asked for its current position.

     */

    navigator.geolocation.getCurrentPosition(

        async function(position) {

            const lat = position.coords.latitude;

            const lon = position.coords.longitude;



            latitudeInput.value = lat;

            longitudeInput.value = lon;



            coordinatesDisplay.textContent =

                lat.toFixed(7) + ', ' + lon.toFixed(7);



            setStatus('Location found. Getting street and barangay...');



            try {

                /*

                 * Nominatim reverse geocoding.

                 * The browser obtains the GPS coordinates; this request

                 * converts those coordinates into a readable address.

                 */

                const url =

                    'https://nominatim.openstreetmap.org/reverse' +

                    '?format=jsonv2' +

                    '&lat=' + encodeURIComponent(lat) +

                    '&lon=' + encodeURIComponent(lon) +

                    '&zoom=18' +

                    '&addressdetails=1';



                const response = await fetch(url, {

                    headers: {

                        'Accept': 'application/json'

                    }

                });



                if (!response.ok) {

                    throw new Error('Reverse geocoding failed');

                }



                const data = await response.json();

                const a = data.address || {};



                /*

                 * Barangay in Philippine addresses is commonly returned

                 * under village/suburb/neighbourhood. We check several

                 * possible OpenStreetMap fields.

                 */

                const barangay =

                    a.village ||

                    a.suburb ||

                    a.neighbourhood ||

                    a.quarter ||

                    a.hamlet ||

                    '';



                /*

                 * Street may be returned as road. If unavailable,

                 * we fall back to pedestrian/path.

                 */

                const street =

                    a.road ||

                    a.pedestrian ||

                    a.footway ||

                    a.path ||

                    '';



                const fullAddress =

                    data.display_name ||

                    [

                        street,

                        barangay,

                        a.city || a.town || a.municipality || '',

                        a.state || '',

                        a.country || ''

                    ].filter(Boolean).join(', ');



                barangayInput.value = barangay;

                streetInput.value = street;

                locationAddressInput.value = fullAddress;



                barangayDisplay.textContent = barangay || 'Not identified';

                streetDisplay.textContent = street || 'Not identified';

                addressDisplay.textContent = fullAddress || 'Not identified';



                setStatus('Realtime location ready.');

            } catch (error) {

                /*

                 * Coordinates are still retained even if reverse

                 * geocoding is unavailable.

                 */

                setStatus('GPS found, but address lookup is unavailable.');



                barangayDisplay.textContent = 'Not identified';

                streetDisplay.textContent = 'Not identified';

                addressDisplay.textContent = 'Coordinates saved';

            }

        },

        function(error) {

            let text = 'Location unavailable. Attendance can still be submitted.';



            if (error && error.code === 1) {

                text = 'Location permission denied. Attendance can still be submitted.';

            } else if (error && error.code === 2) {

                text = 'Location unavailable. Attendance can still be submitted.';

            } else if (error && error.code === 3) {

                text = 'Location request timed out. Attendance can still be submitted.';

            }



            setStatus(text);

        },

        {

            enableHighAccuracy: true,

            timeout: 15000,

            maximumAge: 0

        }

    );

}



document.getElementById('getLocationBtn').addEventListener('click', getCurrentLocation);



/*

 * Automatically request the realtime location when the attendance page opens.

 * The user can also press "Get Current Location" again.

 */

window.addEventListener('load', function() {

    getCurrentLocation();

});

</script>



