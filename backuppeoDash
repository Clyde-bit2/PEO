function getStatusBadgeClassJS(status) {
    switch ((status || '').trim()) {
        case 'Pending':
        case 'Pending Approval':
            return 'badge-pending';
        case 'Ongoing':
        case 'Active':
            return 'badge-ongoing';
        case 'On Hold':
        case 'Disapproved':
        case 'Inactive':
            return 'badge-onhold';
        case 'Completed':
        case 'Approved':
        case 'Present':
            return 'badge-completed';
        default:
            return 'badge-pending';
    }
}

