// CALCULATE DURATION IN CALENDAR DAYS
function calculateDuration(startId, targetId, durationId) {
    const sVal = document.getElementById(startId).value;
    const tVal = document.getElementById(targetId).value;
    const durInput = document.getElementById(durationId);

    if (sVal && tVal && durInput) {
        const start = new Date(sVal);
        const target = new Date(tVal);
        const diffTime = target - start;
        if (diffTime >= 0) {
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            durInput.value = diffDays + ' Days';
        } else {
            durInput.value = 'Invalid Date Range';
        }
    }
}

// Currency formatting logic for input fields
function setupCurrencyInputs() {
    document.querySelectorAll('.currency-input').forEach(input => {
        input.addEventListener('input', function(e) {
            let cursorPosition = this.selectionStart;
            let originalLength = this.value.length;

            // 1. Tanggalin ang lahat ng non-numeric characters maliban sa decimal point (.)
            let rawValue = this.value.replace(/[^0-9.]/g, '');
            
            // 2. Siguraduhing isa lang ang decimal point
            const parts = rawValue.split('.');
            if (parts.length > 2) {
                rawValue = parts[0] + '.' + parts.slice(1).join('');
            }

            let [integerPart, decimalPart] = rawValue.split('.');
            
            // 3. Lagyan ng commas (,) ang integer part
            if (integerPart) {
                // I-format gamit ang thousands separators (e.g., 10000000 -> 10,000,000)
                integerPart = parseInt(integerPart, 10).toLocaleString('en-US');
            }

            // 4. Pagsamahin ulit ang integer at decimal parts
            let formattedValue = integerPart !== undefined ? integerPart : '';
            if (decimalPart !== undefined) {
                formattedValue += '.' + decimalPart.substring(0, 2); // Limit sa 2 decimal places
            }

            this.value = formattedValue;

            // 5. I-adjust ang cursor position para hindi tumalon habang nagta-type
            let newLength = this.value.length;
            cursorPosition = cursorPosition + (newLength - originalLength);
            if (cursorPosition > 0) {
                this.setSelectionRange(cursorPosition, cursorPosition);
            }
        });

        // Pag-blur (pag-alis ng focus sa input), i-format nang may .00 kung kailangan
        input.addEventListener('blur', function() {
            if (this.value) {
                let cleanVal = parseFloat(this.value.replace(/,/g, ''));
                if (!isNaN(cleanVal)) {
                    this.value = cleanVal.toLocaleString('en-US', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
            }
        });
    });
}

