function openFilteredFolderModal(type, title) {
    const allProjects = <?php echo json_encode($projects); ?>;
    const allWorkforce = <?php echo json_encode($workforceList); ?>;
    const allRejectedProposals = <?php echo json_encode($rejectedApprovalProjects ?? []); ?>;
    
    let filtered = [];
    if (type === 'approve project') {
        filtered = allProjects.filter(p => p.status === 'Approved');
    } else if (type === 'ongoing') {
        filtered = allProjects.filter(p => p.status === 'Ongoing');
    } else if (type === 'onhold') {
        filtered = allProjects.filter(p => p.status === 'On Hold' || p.status === 'Not complete');
    } else if (type === 'complete') {
        filtered = allProjects.filter(p => p.status === 'Completed');
    } else if (type === 'decline') {
        // Kasama na rin ang mga proposal na na-reject sa Approval Queue (peoproject_approval),
        // hindi lang ang mga disapproved/rejected sa main Project Monitoring table.
        filtered = allProjects.filter(p => p.status === 'Disapproved' || p.status === 'Rejected')
            .concat(allRejectedProposals);
    } else if (type === 'workforce') {
        openStatModal('Workforce Personnel Folder', allWorkforce);
        return;
    }

    openStatModal(title, filtered);
}

